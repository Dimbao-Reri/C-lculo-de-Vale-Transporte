<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Vale Transporte · Todos os Estados</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f0f4f8;
    --card: #ffffff;
    --primary: #1a6b4a;
    --primary-light: #e8f5ef;
    --accent: #2ecc71;
    --text: #1a2332;
    --muted: #7a8fa6;
    --border: #dde4ed;
    --result-bg: #1a6b4a;
    --danger: #e74c3c;
    --danger-light: #fde8e7;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 24px 16px 40px;
    color: var(--text);
  }

  .container {
    width: 100%;
    max-width: 420px;
  }

  header {
    text-align: center;
    margin-bottom: 28px;
    padding-top: 8px;
  }

  .logo-icon {
    width: 52px;
    height: 52px;
    background: var(--primary);
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 24px;
  }

  header h1 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  header p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 4px;
  }

  .card {
    background: var(--card);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 16px;
  }

  .field-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  .city-state-row {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }
  
  .city-input {
    flex: 2;
  }
  
  .state-input {
    flex: 1;
  }
  
  .city-input input, .state-input select {
    width: 100%;
    height: 48px;
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 0 14px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    background: white;
    outline: none;
    transition: border-color 0.15s;
  }
  
  .city-input input:focus, .state-input select:focus {
    border-color: var(--primary);
  }

  .month-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .month-nav button {
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--border);
    background: white;
    border-radius: 12px;
    cursor: pointer;
    font-size: 18px;
    color: var(--text);
    flex-shrink: 0;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .month-nav button:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-light);
  }

  .month-display {
    flex: 1;
    text-align: center;
    background: var(--primary-light);
    border-radius: 12px;
    padding: 10px;
  }

  .month-display .month-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--primary);
    text-transform: capitalize;
  }

  .month-display .year-name {
    font-size: 12px;
    color: var(--primary);
    opacity: 0.7;
    margin-top: 1px;
  }

  .price-input-wrap {
    position: relative;
    margin-bottom: 20px;
  }

  .currency-prefix {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    pointer-events: none;
  }

  input[type="number"] {
    width: 100%;
    height: 48px;
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 0 14px 0 40px;
    font-size: 18px;
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    color: var(--text);
    background: white;
    outline: none;
    transition: border-color 0.15s;
    -moz-appearance: textfield;
  }

  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; }

  input[type="number"]:focus {
    border-color: var(--primary);
  }

  .trips-row {
    margin-bottom: 4px;
  }

  .trips-options {
    display: flex;
    gap: 8px;
  }

  .trip-btn {
    flex: 1;
    height: 44px;
    border: 1.5px solid var(--border);
    background: white;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s;
    font-family: 'DM Sans', sans-serif;
  }

  .trip-btn.active {
    border-color: var(--primary);
    background: var(--primary-light);
    color: var(--primary);
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 16px 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }

  .info-row .label {
    font-size: 13px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .info-row .value {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    font-family: 'DM Mono', monospace;
  }

  .info-row .value.highlight {
    color: var(--primary);
  }

  .result-card {
    background: var(--result-bg);
    border-radius: 20px;
    padding: 24px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(26,107,74,0.25);
  }

  .result-card .result-label {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 8px;
  }

  .result-card .result-value {
    font-size: 40px;
    font-weight: 600;
    color: white;
    font-family: 'DM Mono', monospace;
    letter-spacing: -1px;
    line-height: 1;
  }

  .result-card .result-sub {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    margin-top: 10px;
  }

  .holidays-list, .custom-holidays-list, .state-holidays-list {
    margin-top: 4px;
  }

  .holiday-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }

  .holiday-item:last-child { border-bottom: none; }

  .holiday-item .h-date {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    width: 60px;
    flex-shrink: 0;
  }

  .holiday-item .h-name {
    color: var(--text);
    flex: 1;
  }

  .holiday-item .h-badge {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    font-weight: 500;
    flex-shrink: 0;
  }

  .badge-nacional { background: #e8f0fe; color: #3b6ddb; }
  .badge-estadual { background: #fce8f3; color: #c0397a; }
  .badge-municipal { background: #e8f5ef; color: #1a6b4a; }
  .badge-personalizado { background: #fef5e7; color: #e67e22; }

  .btn-delete {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 4px 8px;
    border-radius: 8px;
    transition: all 0.15s;
    color: var(--muted);
  }

  .btn-delete:hover {
    background: var(--danger-light);
    color: var(--danger);
  }

  .no-holidays {
    font-size: 13px;
    color: var(--muted);
    text-align: center;
    padding: 12px 0;
  }

  .section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .add-holiday-btn {
    background: var(--primary-light);
    border: none;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    color: var(--primary);
    cursor: pointer;
    transition: all 0.15s;
  }

  .add-holiday-btn:hover {
    background: var(--primary);
    color: white;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  .modal-content {
    background: white;
    border-radius: 20px;
    padding: 24px;
    width: 90%;
    max-width: 340px;
  }

  .modal-content h3 {
    margin-bottom: 16px;
    font-size: 18px;
  }

  .modal-content input, .modal-content select {
    width: 100%;
    height: 44px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 0 12px;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .modal-buttons {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .modal-buttons button {
    flex: 1;
    height: 40px;
    border: none;
    border-radius: 12px;
    font-weight: 500;
    cursor: pointer;
  }

  .btn-save {
    background: var(--primary);
    color: white;
  }

  .btn-cancel {
    background: var(--border);
    color: var(--text);
  }

  .footer {
    text-align: center;
    padding: 20px 0 8px;
  }

  .footer a {
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    font-family: 'DM Mono', monospace;
    letter-spacing: 0.3px;
    transition: color 0.15s;
  }

  .footer a:hover { color: var(--primary); }
</style>
</head>
<body>
<div class="container">
  <header>
    <div class="logo-icon">🚌</div>
    <h1>Vale Transporte</h1>
    <p>Calculadora para todo o Brasil</p>
  </header>

  <div class="card">
    <div class="field-label">Localização</div>
    <div class="city-state-row">
      <div class="city-input">
        <input type="text" id="cidade" placeholder="Cidade" value="Sua Cidade">
      </div>
      <div class="state-input">
        <select id="estado" onchange="mudarEstado()">
          <option value="AC">AC</option><option value="AL">AL</option><option value="AP">AP</option>
          <option value="AM">AM</option><option value="BA">BA</option><option value="CE">CE</option>
          <option value="DF">DF</option><option value="ES">ES</option><option value="GO">GO</option>
          <option value="MA">MA</option><option value="MT">MT</option><option value="MS">MS</option>
          <option value="MG">MG</option><option value="PA">PA</option><option value="PB">PB</option>
          <option value="PR">PR</option><option value="PE">PE</option><option value="PI">PI</option>
          <option value="RJ">RJ</option><option value="RN">RN</option><option value="RS">RS</option>
          <option value="RO">RO</option><option value="RR">RR</option><option value="SC">SC</option>
          <option value="SP">SP</option><option value="SE">SE</option><option value="TO">TO</option>
        </select>
      </div>
    </div>

    <div class="field-label">Mês de referência</div>
    <div class="month-nav">
      <button onclick="changeMonth(-1)">‹</button>
      <div class="month-display">
        <div class="month-name" id="monthName"></div>
        <div class="year-name" id="yearName"></div>
      </div>
      <button onclick="changeMonth(1)">›</button>
    </div>

    <div class="field-label">Valor da passagem</div>
    <div class="price-input-wrap">
      <span class="currency-prefix">R$</span>
      <input type="number" id="passagem" placeholder="0,00" step="0.01" min="0" oninput="calcular()">
    </div>

    <div class="trips-row">
      <div class="field-label">Passagens por dia</div>
      <div class="trips-options">
        <button class="trip-btn active" id="btn2" onclick="setTrips(2)">2 passagens</button>
        <button class="trip-btn" id="btn4" onclick="setTrips(4)">4 passagens</button>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="info-row">
      <span class="label">📅 Dias no mês</span>
      <span class="value" id="diasMes">—</span>
    </div>
    <div class="info-row">
      <span class="label">🚫 Fins de semana</span>
      <span class="value" id="fimDeSemana">—</span>
    </div>
    <div class="info-row">
      <span class="label">🎉 Feriados totais</span>
      <span class="value highlight" id="feriadosCount">—</span>
    </div>
    <div class="divider"></div>
    <div class="info-row">
      <span class="label" style="font-weight:600;color:var(--text)">✅ Dias úteis</span>
      <span class="value highlight" id="diasUteis" style="font-size:18px">—</span>
    </div>
  </div>

  <div class="result-card" id="resultCard">
    <div class="result-label">Total do Vale Transporte</div>
    <div class="result-value" id="resultValue">R$ —</div>
    <div class="result-sub" id="resultSub"></div>
  </div>

  <div class="card">
    <div class="section-title">Feriados Nacionais</div>
    <div class="holidays-list" id="holidaysList"></div>
  </div>

  <div class="card">
    <div class="section-title">Feriados Estaduais</div>
    <div class="state-holidays-list" id="stateHolidaysList"></div>
  </div>

  <div class="card">
    <div class="section-title">
      Feriados Municipais
      <button class="add-holiday-btn" onclick="abrirModalAdicionarFeriado()">+ Adicionar</button>
    </div>
    <div class="custom-holidays-list" id="customHolidaysList"></div>
  </div>

  <div class="footer">
    <a href="https://github.com/Dimbao-Reri" target="_blank">by dimbao</a>
  </div>
</div>

<!-- Modal para adicionar feriado municipal -->
<div id="modal" class="modal">
  <div class="modal-content">
    <h3>Adicionar Feriado Municipal</h3>
    <input type="text" id="novoFeriadoNome" placeholder="Nome do feriado">
    <input type="date" id="novoFeriadoData">
    <div class="modal-buttons">
      <button class="btn-cancel" onclick="fecharModal()">Cancelar</button>
      <button class="btn-save" onclick="adicionarFeriadoMunicipal()">Adicionar</button>
    </div>
  </div>
</div>

<script>
// ============================================
// FERIADOS ESTADUAIS POR UF
// ============================================
const FERIADOS_ESTADUAIS = {
  'AC': [['01-23', 'Dia do Estado do Acre']],
  'AL': [['09-16', 'Emancipação Política de Alagoas']],
  'AP': [['10-05', 'Criação do Estado do Amapá'], ['03-19', 'Dia de São José']],
  'AM': [['09-05', 'Elevação do Amazonas à Província']],
  'BA': [['07-02', 'Independência da Bahia']],
  'CE': [['03-25', 'Data Magna do Ceará']],
  'DF': [['04-21', 'Fundação de Brasília']],
  'ES': [['10-28', 'Dia do Servidor Público'], ['11-23', 'Dia do Estado do Espírito Santo']],
  'GO': [['07-26', 'Emancipação Política de Goiás']],
  'MA': [['07-28', 'Adesão do Maranhão à Independência']],
  'MT': [['11-20', 'Consciência Negra'], ['10-03', 'Criação da Capitania de Mato Grosso']],
  'MS': [['10-11', 'Criação do Estado de Mato Grosso do Sul']],
  'MG': [['04-21', 'Tiradentes (Estadual)'], ['07-16', 'Emancipação Política de Minas Gerais']],
  'PA': [['08-15', 'Adesão do Pará à Independência']],
  'PB': [['08-05', 'Fundação do Estado da Paraíba']],
  'PR': [['12-19', 'Emancipação Política do Paraná']],
  'PE': [['03-06', 'Revolução Pernambucana'], ['07-02', 'Independência de Pernambuco']],
  'PI': [['10-19', 'Dia do Piauí']],
  'RJ': [['04-23', 'Dia de São Jorge'], ['11-20', 'Consciência Negra']],
  'RN': [['08-07', 'Emancipação Política do Rio Grande do Norte']],
  'RS': [['09-20', 'Revolução Farroupilha']],
  'RO': [['01-04', 'Criação do Estado de Rondônia']],
  'RR': [['10-05', 'Criação de Roraima']],
  'SC': [['08-11', 'Data Magna de Santa Catarina']],
  'SP': [['07-09', 'Revolução Constitucionalista'], ['01-25', 'Aniversário de São Paulo']],
  'SE': [['07-08', 'Emancipação Política de Sergipe']],
  'TO': [['10-05', 'Criação do Estado do Tocantins']]
};

// Estado atual selecionado
let estadoAtual = 'SC';

// ============================================
// FERIADOS NACIONAIS
// ============================================
let FERIADOS = {};

function addF(data, nome, tipo) {
  FERIADOS[data] = { nome, tipo };
}

function calcPascoa(ano) {
  const a = ano % 19, b = Math.floor(ano/100), c = ano % 100;
  const d = Math.floor(b/4), e = b % 4;
  const f = Math.floor((b+8)/25), g = Math.floor((b-f+1)/3);
  const h = (19*a + b - d - g + 15) % 30;
  const i = Math.floor(c/4), k = c % 4;
  const l = (32 + 2*e + 2*i - h - k) % 7;
  const m = Math.floor((a + 11*h + 22*l) / 451);
  const mes = Math.floor((h + l - 7*m + 114) / 31);
  const dia = ((h + l - 7*m + 114) % 31) + 1;
  return new Date(ano, mes-1, dia);
}

function addDias(data, dias) {
  const d = new Date(data);
  d.setDate(d.getDate() + dias);
  return d;
}

function fmt(d) {
  return d.getFullYear() + '-' +
    String(d.getMonth()+1).padStart(2,'0') + '-' +
    String(d.getDate()).padStart(2,'0');
}

function carregarFeriadosNacionais(ano) {
  addF(`${ano}-01-01`, 'Confraternização Universal', 'nacional');
  addF(`${ano}-04-21`, 'Tiradentes', 'nacional');
  addF(`${ano}-05-01`, 'Dia do Trabalho', 'nacional');
  addF(`${ano}-09-07`, 'Independência do Brasil', 'nacional');
  addF(`${ano}-10-12`, 'Nossa Senhora Aparecida', 'nacional');
  addF(`${ano}-11-02`, 'Finados', 'nacional');
  addF(`${ano}-11-15`, 'Proclamação da República', 'nacional');
  addF(`${ano}-11-20`, 'Consciência Negra', 'nacional');
  addF(`${ano}-12-25`, 'Natal', 'nacional');

  const pascoa = calcPascoa(ano);
  addF(fmt(addDias(pascoa, -48)), 'Carnaval (Segunda)', 'nacional');
  addF(fmt(addDias(pascoa, -47)), 'Carnaval (Terça)', 'nacional');
  addF(fmt(addDias(pascoa, -2)),  'Sexta-feira Santa', 'nacional');
  addF(fmt(pascoa),               'Páscoa', 'nacional');
  addF(fmt(addDias(pascoa, 60)),  'Corpus Christi', 'nacional');
}

// Carregar anos 2025-2030
[2025, 2026, 2027, 2028, 2029, 2030].forEach(carregarFeriadosNacionais);

// ============================================
// FERIADOS ESTADUAIS DINÂMICOS
// ============================================
let FERIADOS_ESTADO = {};

function atualizarFeriadosEstaduais(uf, ano) {
  FERIADOS_ESTADO = {};
  const feriadosUF = FERIADOS_ESTADUAIS[uf] || [];
  
  feriadosUF.forEach(([mesDia, nome]) => {
    const data = `${ano}-${mesDia}`;
    FERIADOS_ESTADO[data] = { nome, tipo: 'estadual' };
  });
  
  // Alguns feriados estaduais são móveis? Raramente, mas podemos adicionar se necessário
  // Por enquanto só fixos
}

// ============================================
// FERIADOS MUNICIPAIS (localStorage)
// ============================================
let FERIADOS_MUNICIPAIS = {};

function carregarFeriadosMunicipais() {
  const saved = localStorage.getItem('feriadosMunicipais');
  if (saved) {
    FERIADOS_MUNICIPAIS = JSON.parse(saved);
  }
}

function salvarFeriadosMunicipais() {
  localStorage.setItem('feriadosMunicipais', JSON.stringify(FERIADOS_MUNICIPAIS));
}

function adicionarFeriadoMunicipal(data, nome) {
  FERIADOS_MUNICIPAIS[data] = { nome, tipo: 'municipal' };
  salvarFeriadosMunicipais();
  calcular();
}

function removerFeriadoMunicipal(data) {
  delete FERIADOS_MUNICIPAIS[data];
  salvarFeriadosMunicipais();
  calcular();
}

// ============================================
// ESTADO DA APLICAÇÃO
// ============================================
let currentDate = new Date();
let currentMonth = currentDate.getMonth();
let currentYear = currentDate.getFullYear();
let tripsPerDay = 2;

const MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

// ============================================
// LÓGICA DE CÁLCULO
// ============================================
function getDiasUteis(ano, mes) {
  const dias = new Date(ano, mes+1, 0).getDate();
  let uteis = 0;
  const feriadosNacionaisNoMes = [];
  const feriadosEstaduaisNoMes = [];
  const feriadosMunicipaisNoMes = [];

  for (let d = 1; d <= dias; d++) {
    const date = new Date(ano, mes, d);
    const dow = date.getDay();
    const key = fmt(date);
    const isFimSemana = dow === 0 || dow === 6;
    
    const isFeriadoNacional = !!FERIADOS[key];
    const isFeriadoEstadual = !!FERIADOS_ESTADO[key];
    const isFeriadoMunicipal = !!FERIADOS_MUNICIPAIS[key];
    const isFeriado = isFeriadoNacional || isFeriadoEstadual || isFeriadoMunicipal;

    if (!isFimSemana && isFeriadoNacional) {
      feriadosNacionaisNoMes.push({ dia: d, ...FERIADOS[key], dow });
    }
    if (!isFimSemana && isFeriadoEstadual) {
      feriadosEstaduaisNoMes.push({ dia: d, ...FERIADOS_ESTADO[key], dow });
    }
    if (!isFimSemana && isFeriadoMunicipal) {
      feriadosMunicipaisNoMes.push({ dia: d, ...FERIADOS_MUNICIPAIS[key], dow, key });
    }

    if (!isFimSemana && !isFeriado) uteis++;
  }

  const totalFimSemana = Array.from({length: dias}, (_,i) => {
    const d = new Date(ano, mes, i+1).getDay();
    return d === 0 || d === 6;
  }).filter(Boolean).length;

  return { 
    uteis, 
    feriadosNacionais: feriadosNacionaisNoMes,
    feriadosEstaduais: feriadosEstaduaisNoMes,
    feriadosMunicipais: feriadosMunicipaisNoMes,
    totalDias: dias, 
    totalFimSemana 
  };
}

function calcular() {
  const passagem = parseFloat(document.getElementById('passagem').value) || 0;
  const { uteis, feriadosNacionais, feriadosEstaduais, feriadosMunicipais, totalDias, totalFimSemana } = getDiasUteis(currentYear, currentMonth);
  const totalFeriados = feriadosNacionais.length + feriadosEstaduais.length + feriadosMunicipais.length;

  document.getElementById('diasMes').textContent = totalDias;
  document.getElementById('fimDeSemana').textContent = totalFimSemana;
  document.getElementById('feriadosCount').textContent = totalFeriados;
  document.getElementById('diasUteis').textContent = uteis;

  const total = uteis * tripsPerDay * passagem;
  const resultValue = document.getElementById('resultValue');

  if (passagem > 0) {
    resultValue.textContent = 'R$ ' + total.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
    document.getElementById('resultSub').textContent = `${uteis} dias × ${tripsPerDay} passagens × R$ ${passagem.toFixed(2).replace('.',',')}`;
  } else {
    resultValue.textContent = 'R$ —';
    document.getElementById('resultSub').textContent = 'Informe o valor da passagem';
  }

  // Feriados nacionais
  const list = document.getElementById('holidaysList');
  const diasSemana = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  
  if (feriadosNacionais.length === 0) {
    list.innerHTML = '<div class="no-holidays">Nenhum feriado nacional neste mês</div>';
  } else {
    list.innerHTML = feriadosNacionais.map(f => `
      <div class="holiday-item">
        <span class="h-date">${String(f.dia).padStart(2,'0')}/${String(currentMonth+1).padStart(2,'0')} ${diasSemana[f.dow]}</span>
        <span class="h-name">${f.nome}</span>
        <span class="h-badge badge-nacional">nacional</span>
      </div>
    `).join('');
  }
  
  // Feriados estaduais
  const stateList = document.getElementById('stateHolidaysList');
  if (feriadosEstaduais.length === 0) {
    stateList.innerHTML = '<div class="no-holidays">Nenhum feriado estadual neste mês</div>';
  } else {
    stateList.innerHTML = feriadosEstaduais.map(f => `
      <div class="holiday-item">
        <span class="h-date">${String(f.dia).padStart(2,'0')}/${String(currentMonth+1).padStart(2,'0')} ${diasSemana[f.dow]}</span>
        <span class="h-name">${f.nome}</span>
        <span class="h-badge badge-estadual">estadual</span>
      </div>
    `).join('');
  }
  
  // Feriados municipais
  const customList = document.getElementById('customHolidaysList');
  if (feriadosMunicipais.length === 0) {
    customList.innerHTML = '<div class="no-holidays">Nenhum feriado municipal adicionado. Clique em "+ Adicionar"</div>';
  } else {
    customList.innerHTML = feriadosMunicipais.map(f => `
      <div class="holiday-item">
        <span class="h-date">${String(f.dia).padStart(2,'0')}/${String(currentMonth+1).padStart(2,'0')} ${diasSemana[f.dow]}</span>
        <span class="h-name">${f.nome}</span>
        <span class="h-badge badge-municipal">municipal</span>
        <button class="btn-delete" onclick="removerFeriadoMunicipal('${f.key}')">🗑️</button>
      </div>
    `).join('');
  }
  
  // Atualizar header
  const cidade = document.getElementById('cidade').value || "Sua Cidade";
  const uf = document.getElementById('estado').value;
  document.querySelector('header p').textContent = `${cidade} - ${uf} · ${currentYear}`;
}

function mudarEstado() {
  estadoAtual = document.getElementById('estado').value;
  atualizarFeriadosEstaduais(estadoAtual, currentYear);
  calcular();
}

function changeMonth(dir) {
  currentMonth += dir;
  if (currentMonth > 11) { currentMonth = 0; currentYear++; }
  if (currentMonth < 0)  { currentMonth = 11; currentYear--; }

  if (currentYear < 2025) { currentYear = 2025; currentMonth = 0; }
  if (currentYear > 2030) { currentYear = 2030; currentMonth = 11; }

  document.getElementById('monthName').textContent = MONTHS[currentMonth];
  document.getElementById('yearName').textContent = currentYear;
  atualizarFeriadosEstaduais(estadoAtual, currentYear);
  calcular();
}

function setTrips(n) {
  tripsPerDay = n;
  document.getElementById('btn2').classList.toggle('active', n === 2);
  document.getElementById('btn4').classList.toggle('active', n === 4);
  calcular();
}

// ============================================
// MODAL FERIADO MUNICIPAL
// ============================================
function abrirModalAdicionarFeriado() {
  document.getElementById('modal').style.display = 'flex';
  document.getElementById('novoFeriadoNome').value = '';
  document.getElementById('novoFeriadoData').value = '';
}

function fecharModal() {
  document.getElementById('modal').style.display = 'none';
}

function adicionarFeriadoMunicipal() {
  const nome = document.getElementById('novoFeriadoNome').value.trim();
  const data = document.getElementById('novoFeriadoData').value;
  
  if (!nome || !data) {
    alert('Preencha o nome e a data do feriado');
    return;
  }
  
  const ano = parseInt(data.split('-')[0]);
  if (ano < 2025 || ano > 2030) {
    alert('Feriados só podem ser adicionados entre 2025 e 2030');
    fecharModal();
    return;
  }
  
  // Verificar se já existe feriado nesta data
  if (FERIADOS[data] || FERIADOS_ESTADO[data] || FERIADOS_MUNICIPAIS[data]) {
    alert('Já existe um feriado cadastrado nesta data!');
    fecharModal();
    return;
  }
  
  adicionarFeriadoMunicipal(data, nome);
  fecharModal();
}

// ============================================
// INICIALIZAÇÃO
// ============================================
document.addEventListener('DOMContentLoaded', function() {
  carregarFeriadosMunicipais();
  
  const estadoSelect = document.getElementById('estado');
  estadoSelect.value = 'SC';
  estadoAtual = 'SC';
  atualizarFeriadosEstaduais('SC', currentYear);
  
  const cidadeInput = document.getElementById('cidade');
  if (cidadeInput) {
    cidadeInput.addEventListener('input', () => calcular());
  }
  
  document.getElementById('monthName').textContent = MONTHS[currentMonth];
  document.getElementById('yearName').textContent = currentYear;
  calcular();
});

window.onclick = function(event) {
  const modal = document.getElementById('modal');
  if (event.target === modal) {
    fecharModal();
  }
}
</script>
